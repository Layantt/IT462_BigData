g4Model.write.overwrite().save(s"$g4OutputDir/rf_full_pipeline_model")
g4RFTrained.write.overwrite().save(s"$g4OutputDir/rf_model_only")

val g4PredictionCols = Seq("label", "prediction", "probability", "rawPrediction")
g4TrainPred.select(g4PredictionCols.map(org.apache.spark.sql.functions.col): _*)
  .write.mode("overwrite").parquet(s"$g4OutputDir/rf_train_predictions.parquet")
g4TestPred.select(g4PredictionCols.map(org.apache.spark.sql.functions.col): _*)
  .write.mode("overwrite").parquet(s"$g4OutputDir/rf_test_predictions.parquet")

println("Girl 4 completed: Random Forest model and train/test predictions saved.")


