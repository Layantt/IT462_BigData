import org.apache.spark.ml.{Pipeline, PipelineStage}
import org.apache.spark.ml.classification.{RandomForestClassifier, RandomForestClassificationModel}

// Reuse the fitted preprocessing stages created by Girl 2.
// No re-splitting or re-fitting categorical encoders is performed.
val g4RF = new RandomForestClassifier()
  .setLabelCol("label")
  .setFeaturesCol("features")
  .setNumTrees(100)
  .setSeed(42)

val g4Stages: Array[PipelineStage] =
  g2PipelineModel.stages.map(stage => stage: PipelineStage) ++ Array[PipelineStage](g4RF)
val g4Pipeline = new Pipeline().setStages(g4Stages)

// Train the classifier using the same saved splits used by Girl 2.
val g4Model = g4Pipeline.fit(g2TrainDF)
val g4TrainPred = g4Model.transform(g2TrainDF)
val g4TestPred = g4Model.transform(g2TestDF)

val g4RFTrained = g4Model.stages.last.asInstanceOf[RandomForestClassificationModel]
println("Number of trained trees: " + g4RFTrained.getNumTrees)
println("Feature dimensions: " + g4RFTrained.numFeatures)

// Sample predictions: all records, then rows with actual label = Attack (1).
g4TestPred.select("label", "prediction", "probability").show(20, false)
g4TestPred.filter("label = 1.0")
  .select("label", "prediction", "probability")
  .show(20, false)

// These output paths match the paths read by Girl 5 below.
